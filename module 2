EXERCISES---
-----1 USER UPCOMING EVENTS -----------------

select title from Events as e join Registrations as r
on e.event_id =r.event_id join Users as u 
on u.user_id=r.user_id
where u.city=e.city and e.status='upcoming'    
order by e.start_date;

---------------- 2 TOP RATED EVENTS -------------

select event_id,(avg(rating)) as avg_rating from Feedback 
group by event_id 
having(count(*)>=10) order by avg_rating;


-------------3 InActive Users --------------------
select user_id from Users 
    where user_id not in(
select user_id from Registrations
where (CURRENT_DATE -registration_date)>=90);



------------4 Peak Session Hours ------------------
select count(session_id),event_id from Sessions
    where ( TIME(start_time) >='10:00:00' && TIME(end_time)<='12:00:00')
    group by event_id;


-------------5 Most Active Cities ------------------
select count(distinct(r.user_id)) as cnt ,city from Users as u 
join Registrations as r
on r.user_id=u.user_id 
group by city  order by cnt desc limit 5;



------------6 Event Resource Summary -----------------
select count(resource_type) from Resources group by event_id;


-------------7 Low Feedback Alerts ---------
select full_name,title,comments from Feedback as f 
join Users as u on u.user_id=f.user_id 
join Events as e 
on 
e.event_id=f.event_id where rating <3;

------------8 Sessions per Upcoming Event----------------------
select e.title,count(session_id) from Events as e 
left join Sessions as s 
on
e.event_id=s.event_id
where status='upcoming' 
    group by s.event_id ;

-----------------9 Organizer Event Summary ----------------
