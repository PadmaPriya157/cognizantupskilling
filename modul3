// 31 . Basic JDBC Connection
import java.util.*;
import java.sql.*;
public class Main
{
	public static void main(String[] args) {
		System.out.println("Hello World");
		try{
		Connection con=DriverManager.getConnection("https","username","password");
		PreparedStatement stmt=con.prepareStatement("select * from Students");
	    ResultSet res=stmt.executeQuery();
	    while(res.next())
	    {
	        String name=res.getString("name");
	        System.out.println(name);
	    }
	   // System.out.println("asdfghj");
	    con.close();
	    stmt.close();
		    
		}
		catch(Exception e)
		{
		    System.out.println("error");
		}
		
	}
}

// 32 . insert
import java.util.*;
import java.sql.*;
public class Main
{
	public static void main(String[] args) {
		System.out.println("Hello World");
		try{
		Connection con=DriverManager.getConnection("https","username","password");
	    String query="insert into sttudent values(?,?)";
		PreparedStatement stmt=con.prepareStatement(query);
	    stmt.setInt(1,1);
	    stmt.setString(2,"priya");
	    stmt.executeUpdate();
	    System.out.println("inserted sucessfully")
	  
	    con.close();
	    stmt.close();
		    
		}
		catch(Exception e)
		{
		    System.out.println("error");
		}
		
	}
}

