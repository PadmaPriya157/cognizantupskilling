import java.util.*;
import java.sql.*;
public class Main
{
	public static void main(String[] args) {
		System.out.println("Hello World");
		try{
		Connection con=DriverManager.getConnection("https","username","password");
	    String query="update sttudent set name=? where id=?";
		PreparedStatement stmt=con.prepareStatement(query);
	    stmt.setString(1,"priya");
	    stmt.setInt(2,1);
	    stmt.executeUpdate();
	    System.out.println("updated sucessfully")
	  
	    con.close();
	    stmt.close();
		    
		}
		catch(Exception e)
		{
		    System.out.println("error");
		}
		
	}
}
